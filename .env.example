# Kopiere diese Datei nach .env und passe die Werte an.
# Alle Variablen sind optional – ohne MQTT läuft die App als Standalone-Web-App.

# --- Allgemein ---
POOL_DATABASE_URL=sqlite:////data/pool.db
POOL_TIMEZONE=Europe/Berlin

# --- MQTT / Home Assistant (optional) ---
POOL_MQTT_ENABLED=false
POOL_MQTT_HOST=homeassistant.local
POOL_MQTT_PORT=1883
POOL_MQTT_USERNAME=
POOL_MQTT_PASSWORD=
POOL_MQTT_BASE_TOPIC=poolsurveylance
POOL_MQTT_DISCOVERY_PREFIX=homeassistant
POOL_DEVICE_ID=poolsurveylance
